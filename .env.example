# Copy this file to .env and fill it in. Never put a real key in this file.

# --- Model ---
# A chat agent that plans several tool calls benefits from a stronger model,
# so start with Sonnet. Haiku is cheaper and worth comparing later.
LLM_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=

# --- Salesforce ---
# The Revenue Cloud org, logged in once with:
#   sf org login web --alias rcadev
SF_ORG_ALIAS=rcadev
# API version used for REST calls (Revenue Cloud APIs need 63.0 or later).
SF_API_VERSION=64.0
